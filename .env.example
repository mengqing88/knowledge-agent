# Copy project 1's model values here. Never commit the real .env.
CHAT_API_KEY=
CHAT_BASE_URL=
MODEL=
CHAT_API_STYLE=responses
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# 0: discover dimension at ingestion; all vectors in one index must match.
EMBEDDING_DIMENSIONS=0
# Change this when the service changes weights behind the same model name.
EMBEDDING_REVISION=default
# Reference tokenizer: cl100k_base, not the provider's exact billing tokenizer.
CHUNK_STRATEGY=fixed
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# Used only by semantic; lower adjacent-sentence cosine starts a new chunk.
CHUNK_SEMANTIC_THRESHOLD=0.55
# Per-document sentence-unit cap, checked before semantic boundary embeddings.
CHUNK_SEMANTIC_MAX_UNITS=128
VECTOR_STORE=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_PREFIX=paperqa
MILVUS_INDEX_TYPE=HNSW
MILVUS_TIMEOUT_SECONDS=20
DATABASE_URL=postgresql+psycopg://paperqa:paperqa@localhost:55432/paperqa
STORAGE_DIR=./data/pdfs
# Used only to adopt the original local demo during account bootstrap.
LOCAL_USER_ID=local-user
MAX_UPLOAD_MB=40
MAX_RETRIEVAL_ROUNDS=2
MAX_REVISION_ROUNDS=1
MAX_MODEL_CALLS=8
MAX_RUN_SECONDS=240
MAX_CONTEXT_CHARS=28000
# Request guards use UTF-8 byte estimates, not exact provider tokenization.
MAX_REQUEST_INPUT_TOKENS=120000
MAX_RUN_TOKENS=1000000
MAX_OUTPUT_TOKENS=6000
MAX_EMBEDDING_BATCH_TOKENS=100000
# Optional fee cap. Set actual currency and documented model prices before enabling.
# MAX_RUN_COST=1
# CHAT_INPUT_PRICE_PER_MILLION=
# CHAT_OUTPUT_PRICE_PER_MILLION=
# EMBEDDING_PRICE_PER_MILLION=
PRICE_CURRENCY=
PRICE_SOURCE=
MODEL_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=1
PROVIDER_BACKOFF_SECONDS=0.5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
MAX_PENDING_JOBS=40
MAX_PENDING_RUNS_PER_USER=3
MAX_RUNNING_JOBS=2
MAX_JOB_ATTEMPTS=3
ANSWER_REVIEW_REQUIRED=true
# Full-agent only: check evidence sufficiency before generating the answer.
EVIDENCE_GATE_ENABLED=true
MAX_INGEST_SECONDS=600
WORKER_LEASE_SECONDS=90
# Optional local code-repair source root; tasks may only select clean Git repositories beneath it.
CODE_REPOSITORY_ROOT=
CODE_TASK_WORKSPACE_DIR=./data/code_tasks
CODE_TEST_DOCKER_IMAGE=code-repair-sandbox:py311
TASK_BACKEND=celery
CELERY_BROKER_URL=redis://127.0.0.1:56379/0
SESSION_HOURS=24
# Explicit server configuration and per-user/corpus tool permissions are required.
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
MCP_SERVERS_FILE=
# Optional upgrades. Existing model settings remain the fallback for unassigned roles.
QUERY_REWRITE_ENABLED=true
QUERY_TERMS_FILE=
QUERY_MAX_PER_SUBQUESTION=5
WORKFLOW_MCP_ENABLED=false
PROJECT_LOGS_MCP_ENABLED=false
MAX_WORKFLOW_TOOL_CALLS=2
MAX_EXTERNAL_EVIDENCE_CHARS=10000
# JSON object of role -> model/base_url/api_key_env/api_style and optional prices.
ROLE_MODEL_ROUTES={}
RERANKER_BACKEND=llm
# Application admission policy; obtain provider limits separately.
PROVIDER_QUOTA_ENABLED=false
PROVIDER_QUOTA_REDIS_URL=redis://127.0.0.1:56379/0
PROVIDER_QUOTA_NAMESPACE=paperqa_model_quota
PROVIDER_QUOTA_RPM=30
PROVIDER_QUOTA_TPM=200000
